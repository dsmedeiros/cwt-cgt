# Force shell scripts and hook templates to be classified as text so that
# git diff and numstat report line counts even if a stray non-printable
# byte slipped into a comment. Without this, a lone NUL in source can flip
# git's auto-detection and hide the entire file from textual diff/grep.
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.tmpl      text eol=lf
*.md        text eol=lf

# Binary categories — keep git from line-ending-mangling these.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary

# Provenance-locked experiment snapshots carry byte-level SHA-256 records.
# Preserve their reviewed bytes while retaining textual diffs.
cwt-sim/experiments/independent_response_theorem/artifacts/** -text !eol diff -whitespace
cwt-sim/experiments/oedi_ieee123_reconstruction/artifacts/** -text !eol diff -whitespace
