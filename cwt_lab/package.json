{
  "name": "cwt_lab",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React laboratory UI for CWT pipeline",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint --ext .ts,.tsx renderer electron",
    "dev": "cross-env NODE_ENV=development electron-vite dev",
    "build": "cross-env NODE_ENV=production electron-vite build",
    "dist": "cross-env NODE_ENV=production electron-builder",
    "pack": "cross-env NODE_ENV=production electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "chokidar": "^3.5.3",
    "electron": "^28.2.0",
    "plotly.js": "^2.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plotly.js": "^2.6.0",
    "uuid": "^9.0.1",
    "yaml": "^2.3.4",
    "zod": "^3.22.4",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/react-plotly.js": "^2.6.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.6.4",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "5.3.3",
    "vite": "^5.0.12"
  }
}
