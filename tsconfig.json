{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "electron/**/*.ts",
    "renderer/**/*.ts",
    "renderer/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
